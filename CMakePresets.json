{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "ninja-debug",
      "displayName": "Debug",
      "description": "Ninja + Debug (-O0) + sanitizers - see ENABLE_SANITIZERS in CMakeLists.txt.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Release",
      "description": "Ninja + Release (-O3, NDEBUG) - debug()/trace() compile out entirely.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-profile",
      "displayName": "Profile",
      "description": "Same as Release (-O3), plus DWARF debug info and -fno-optimize-sibling-calls for readable stack traces under Linux perf. Sanitizers stay off - their overhead would distort the profile.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Profile"
      }
    },
    {
      "name": "ninja-coverage",
      "displayName": "Coverage (gcov/gcovr, GCC only)",
      "description": "Debug (-O0) + --coverage instrumentation on logger/logger_test only; see the 'coverage' target in CMakeLists.txt. Mutually exclusive with ENABLE_SANITIZERS.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "ninja-debug", "displayName": "Build (Debug)" },
    { "name": "release", "configurePreset": "ninja-release", "displayName": "Build (Release)" },
    { "name": "profile", "configurePreset": "ninja-profile", "displayName": "Build (Profile)" },
    { "name": "coverage", "configurePreset": "ninja-coverage", "displayName": "Build (Coverage)", "targets": ["coverage"] }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "ninja-debug",
      "displayName": "Test (Debug)",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "ninja-release",
      "displayName": "Test (Release)",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "profile",
      "configurePreset": "ninja-profile",
      "displayName": "Test (Profile)",
      "output": { "outputOnFailure": true }
    }
  ]
}
